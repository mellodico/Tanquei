# API EconomizaAlagoas
ECONOMIZA_APP_TOKEN=seu_token_aqui
ECONOMIZA_BASE_URL=https://api.sefaz.al.gov.br/sfz-economiza-alagoas-api/api/public

# Server
PORT=3333
NODE_ENV=development
# Origens do frontend autorizadas (separadas por vírgula; "*" casa com letras, números e hífens)
# Produção na Vercel, ex.: https://tanquei.vercel.app,https://tanquei-*-mellodico.vercel.app
CORS_ORIGINS=http://localhost:5173
# Atrás de proxy reverso (Render, Railway, Nginx...): número de proxies na frente do servidor.
# Sem isso, todos os usuários dividem o mesmo limite de requisições. Vazio = sem proxy.
TRUST_PROXY=
# Tempo de cache das buscas de postos (0 desativa)
CACHE_TTL_MINUTES=10

# Banco de dados (Neon / Lakebase Postgres). Use a string *pooled* (host com "-pooler").
# Local: branch dev   -> neon cs dev --pooled --ssl verify-full
# Produção: branch main -> neon cs main --pooled --ssl verify-full
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=verify-full

# Histórico de preços (a API só informa o preço atual; o servidor guarda um registro diário)
# Códigos IBGE coletados periodicamente (separados por vírgula). 2704302 = Maceió
HISTORY_MUNICIPIOS=2704302
HISTORY_INTERVAL_HOURS=6
