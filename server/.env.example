# API EconomizaAlagoas
ECONOMIZA_APP_TOKEN=seu_token_aqui
ECONOMIZA_BASE_URL=http://api.sefaz.al.gov.br/sfz-economiza-alagoas-api/api/public

# Server
PORT=3333
NODE_ENV=development
# Origens do frontend autorizadas (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173

# Banco de dados (Neon / Lakebase Postgres). Use a string *pooled* (host com "-pooler").
# Local: branch dev   -> neon cs dev --pooled --ssl verify-full
# Produção: branch main -> neon cs main --pooled --ssl verify-full
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=verify-full

# Histórico de preços (a API só informa o preço atual; o servidor guarda um registro diário)
# Códigos IBGE coletados periodicamente (separados por vírgula). 2704302 = Maceió
HISTORY_MUNICIPIOS=2704302
HISTORY_INTERVAL_HOURS=6
