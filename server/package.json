{
  "name": "server",
  "version": "1.0.0",
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "node scripts/test-db.mjs",
    "migrate": "node-pg-migrate up -m migrations -j sql --check-order --envPath .env",
    "migrate:create": "node-pg-migrate create -m migrations -j sql",
    "migrate:down": "node-pg-migrate down -m migrations -j sql --envPath .env",
    "db:import-json": "ts-node-dev --transpile-only src/scripts/import-json.ts"
  },
  "keywords": [],
  "author": "",
  "description": "Proxy da API EconomizaAlagoas para o Tanquei",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "@types/pg": "^8.23.1",
    "node-pg-migrate": "^9.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "node-pg-migrate": {
      "glob": "^14.0.6"
    }
  }
}
